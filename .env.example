# All settings are optional. Copy to .env (or export them) to override defaults.
# Every variable uses the AGENT_SIGHT_ prefix.

# Where cached metadata, transcripts, proxies, frames and contact sheets live.
# AGENT_SIGHT_CACHE_DIR=~/.cache/agent-sight
# How long cached metadata/transcripts stay valid (seconds). Default: 7 days.
# AGENT_SIGHT_CACHE_TTL_SECONDS=604800

# Where user-requested downloads are written. MCP downloads are confined to this directory.
# AGENT_SIGHT_OUTPUT_DIR=./downloads
# Refuse downloads larger than this (megabytes).
# AGENT_SIGHT_MAX_DOWNLOAD_MB=2048
# Default quality preset: best | 1080p | 720p | 480p | 360p | worst
# AGENT_SIGHT_DEFAULT_QUALITY=720p

# Explicit binary locations (otherwise PATH, then the imageio-ffmpeg bundle, are used).
# AGENT_SIGHT_FFMPEG_PATH=/usr/bin/ffmpeg
# AGENT_SIGHT_FFPROBE_PATH=/usr/bin/ffprobe

# Local Whisper fallback (pip install 'agent-sight[whisper]').
# AGENT_SIGHT_WHISPER_MODEL=small
# AGENT_SIGHT_WHISPER_DEVICE=auto
# AGENT_SIGHT_WHISPER_ENABLED=true
# Only auto-transcribe inside `digest` for videos up to this many seconds.
# AGENT_SIGHT_WHISPER_MAX_DURATION=900

# Netscape-format cookies file for content YOU are permitted to access (your own account).
# Never commit this file. agent-sight never logs cookie contents.
# AGENT_SIGHT_COOKIES_FILE=/home/me/.config/agent-sight/cookies.txt

# Politeness / reliability.
# AGENT_SIGHT_MIN_REQUEST_INTERVAL=1.0
# AGENT_SIGHT_MAX_RETRIES=3
# AGENT_SIGHT_SOCKET_TIMEOUT=30

# Allow URLs that resolve to localhost/private networks (off by default to prevent SSRF).
# AGENT_SIGHT_ALLOW_PRIVATE_HOSTS=false
